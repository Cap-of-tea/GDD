# GDD remote MCP server for Railway — GDD.Headless behind a Caddy token-auth proxy.
# Public traffic hits Caddy on $PORT; Caddy checks a Bearer token and proxies to
# GDD on 127.0.0.1:9700. GDD itself is never exposed to Railway's edge.

# ---- build GDD.Headless (same as Dockerfile) ----
FROM mcr.microsoft.com/dotnet/sdk:8.0.424 AS build
WORKDIR /src
COPY src/GDD.Core/GDD.Core.csproj src/GDD.Core/
COPY src/GDD.Headless/GDD.Headless.csproj src/GDD.Headless/
RUN dotnet restore src/GDD.Headless/GDD.Headless.csproj
COPY src/ src/
COPY GDD-MANUAL.md .
RUN dotnet publish src/GDD.Headless/GDD.Headless.csproj -c Release -o /app
RUN dotnet tool install --global PowerShell --version 7.4.7
ENV PATH="$PATH:/root/.dotnet/tools"
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.browsers
RUN pwsh /app/playwright.ps1 install chromium

# ---- Caddy static binary (no apt/network needed at runtime) ----
FROM caddy:2.11.4 AS caddy

# ---- runtime ----
FROM mcr.microsoft.com/dotnet/aspnet:8.0.30
LABEL io.modelcontextprotocol.server.name="io.github.imVSmirnov/gdd"
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libglib2.0-0 libnss3 libnspr4 libdbus-1-3 \
    libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libx11-6 libxcomposite1 libxdamage1 libxext6 libxfixes3 \
    libxrandr2 libgbm1 libxcb1 libxkbcommon0 \
    libpango-1.0-0 libcairo2 libasound2 libxshmfence1 libatspi2.0-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app .
COPY --from=caddy /usr/bin/caddy /usr/bin/caddy
COPY Caddyfile /etc/caddy/Caddyfile
COPY docker-entrypoint.railway.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.browsers
# Default: GDD listens on all interfaces inside the container so Caddy can reach
# it (HttpListener "+" prefix matches any Host header). Only Caddy is public.
# Deployments that share a Docker network override this with 127.0.0.1.
ENV GDD__BindAddress=0.0.0.0
# Railway injects PORT; Caddy binds it. GDD stays on 9700 internally.
ENV PORT=8080
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
